# Database (defaults to local SQLite if unset; set for Render/Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# eBay API (leave blank until developer account is approved)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Gemini API (free tier — get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email notifications (Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# Item ownership — identifies items added via manage_items.py as personal
POLLER_OWNER=
